(in-package #:maxwell/json)

(defconstant +null+ :json-null)

(defun json-key (key)
  (etypecase key
    (string key)
    (symbol (string-downcase (symbol-name key)))))

(defun json-object (&rest pairs)
  "Make a JSON object from alternating key/value PAIRS."
  (unless (evenp (length pairs))
    (error "JSON-OBJECT needs an even number of arguments."))
  (let ((object (make-hash-table :test #'equal)))
    (loop for (key value) on pairs by #'cddr
          do (setf (gethash (json-key key) object) value))
    object))

(defun json-array (&rest values)
  (coerce values 'vector))

(defun get-key (object key &optional default)
  (if (hash-table-p object)
      (gethash (json-key key) object default)
      default))

(defun write-json-string (string stream)
  (write-char #\" stream)
  (loop for character across string
        for code = (char-code character)
        do (case character
             (#\" (write-string "\\\"" stream))
             (#\\ (write-string "\\\\" stream))
             (#\Backspace (write-string "\\b" stream))
             (#\Page (write-string "\\f" stream))
             (#\Newline (write-string "\\n" stream))
             (#\Return (write-string "\\r" stream))
             (#\Tab (write-string "\\t" stream))
             (otherwise
              (if (< code 32)
                  (format stream "\\u~4,'0X" code)
                  (write-char character stream)))))
  (write-char #\" stream))

(defun write-json-number (number stream)
  (cond
    ((integerp number) (princ number stream))
    ((rationalp number) (write-json-number (coerce number 'double-float) stream))
    ((realp number)
     ;; Lisp uses implementation float markers such as d0; JSON only permits e/E.
     (let ((text (write-to-string number :readably t)))
       (loop for character across text
             do (write-char (if (find character "dDfFsSlL") #\e character)
                            stream))))
    (t (error "JSON numbers must be real, not ~S." number))))

(defun write-json (value stream)
  (cond
    ((eq value +null+) (write-string "null" stream))
    ((eq value t) (write-string "true" stream))
    ((null value) (write-string "false" stream))
    ((stringp value) (write-json-string value stream))
    ((numberp value) (write-json-number value stream))
    ((hash-table-p value)
     (write-char #\{ stream)
     (let ((first t))
       (maphash (lambda (key item)
                  (unless first (write-char #\, stream))
                  (setf first nil)
                  (write-json-string (string key) stream)
                  (write-char #\: stream)
                  (write-json item stream))
                value))
     (write-char #\} stream))
    ((vectorp value)
     (write-char #\[ stream)
     (loop for item across value
           for first = t then nil
           do (unless first (write-char #\, stream))
              (write-json item stream))
     (write-char #\] stream))
    ((listp value)
     (write-json (coerce value 'vector) stream))
    (t (error "Cannot encode ~S as JSON." value))))

(defun encode (value)
  (with-output-to-string (stream)
    (write-json value stream)))

(defun decode (text)
  "Parse TEXT into strings, numbers, vectors, and EQUAL hash tables."
  (let ((position 0)
        (length (length text)))
    (labels ((peek ()
               (when (< position length) (char text position)))
             (take ()
               (prog1 (peek) (incf position)))
             (spacep (character)
               (and character
                    (member character '(#\Space #\Tab #\Return #\Newline))))
             (skip-space ()
               (loop while (spacep (peek)) do (incf position)))
             (expect (character)
               (unless (eql (take) character)
                 (error "Expected ~S at JSON offset ~D." character position)))
             (hex4 ()
               (let ((value 0))
                 (dotimes (index 4 value)
                   (declare (ignorable index))
                   (let ((digit (digit-char-p (take) 16)))
                     (unless digit (error "Bad Unicode escape at JSON offset ~D." position))
                     (setf value (+ (* value 16) digit))))))
             (string-value ()
               (expect #\")
               (with-output-to-string (stream)
                 (loop for character = (take)
                       do (cond
                            ((null character)
                             (error "Unterminated JSON string."))
                            ((char= character #\") (return))
                            ((char= character #\\)
                             (let ((escape (take)))
                               (case escape
                                 (#\" (write-char #\" stream))
                                 (#\\ (write-char #\\ stream))
                                 (#\/ (write-char #\/ stream))
                                 (#\b (write-char #\Backspace stream))
                                 (#\f (write-char #\Page stream))
                                 (#\n (write-char #\Newline stream))
                                 (#\r (write-char #\Return stream))
                                 (#\t (write-char #\Tab stream))
                                 (#\u
                                  (let ((code (hex4)))
                                    (when (and (<= #xD800 code #xDBFF)
                                               (eql (peek) #\\))
                                      (let ((saved position))
                                        (take)
                                        (if (eql (peek) #\u)
                                            (progn
                                              (take)
                                              (let ((low (hex4)))
                                                (if (<= #xDC00 low #xDFFF)
                                                    (setf code (+ #x10000
                                                                  (* (- code #xD800) #x400)
                                                                  (- low #xDC00)))
                                                    (setf position saved))))
                                            (setf position saved))))
                                    (write-char (or (code-char code)
                                                    (error "Unsupported character U+~X." code))
                                                stream)))
                                 (otherwise (error "Bad JSON escape \\~A." escape)))))
                            (t (write-char character stream))))))
             (number-value ()
               (let ((start position))
                 (loop while (and (peek) (find (peek) "+-0123456789.eE"))
                       do (incf position))
                 (let ((*read-eval* nil)
                       (*read-default-float-format* 'double-float))
                   (multiple-value-bind (number end)
                       (read-from-string text nil nil :start start :end position)
                     (unless (and (numberp number) (= end position))
                       (error "Bad JSON number at offset ~D." start))
                     number))))
             (literal (word value)
               (let ((end (+ position (length word))))
                 (unless (and (<= end length)
                              (string= word text :start2 position :end2 end))
                   (error "Expected ~A at JSON offset ~D." word position))
                 (setf position end)
                 value))
             (array-value ()
               (expect #\[)
               (skip-space)
               (when (eql (peek) #\]) (take) (return-from array-value #()))
               (let ((items '()))
                 (loop
                   (push (value) items)
                   (skip-space)
                   (case (take)
                     (#\] (return (coerce (nreverse items) 'vector)))
                     (#\, (skip-space))
                     (otherwise (error "Expected comma or ] at JSON offset ~D." position))))))
             (object-value ()
               (expect #\{)
               (skip-space)
               (let ((object (make-hash-table :test #'equal)))
                 (when (eql (peek) #\}) (take) (return-from object-value object))
                 (loop
                   (unless (eql (peek) #\")
                     (error "Expected object key at JSON offset ~D." position))
                   (let ((key (string-value)))
                     (skip-space)
                     (expect #\:)
                     (skip-space)
                     (setf (gethash key object) (value)))
                   (skip-space)
                   (case (take)
                     (#\} (return object))
                     (#\, (skip-space))
                     (otherwise (error "Expected comma or } at JSON offset ~D." position))))))
             (value ()
               (skip-space)
               (case (peek)
                 (#\" (string-value))
                 (#\{ (object-value))
                 (#\[ (array-value))
                 (#\t (literal "true" t))
                 (#\f (literal "false" nil))
                 (#\n (literal "null" +null+))
                 (otherwise (number-value)))))
      (let ((result (value)))
        (skip-space)
        (unless (= position length)
          (error "Trailing data at JSON offset ~D." position))
        result))))

(in-package #:maxwell/tests)

(defun test-conversations ()
  (let* ((maxwell::*conversations* nil) (maxwell::*selected-conversation* nil)
         (maxwell::*conversation* nil) (maxwell::*ui-context-wrapper* nil)
         (maxwell::*next-conversation-id* 0) (maxwell::*next-note-id* 0)
         (maxwell::*prompt-draft* "")
         (maxwell:*chat* (maxwell::make-chat))
         (maxwell::*session-entries* (maxwell::make-entry-vector))
         (maxwell:*agent* (maxwell:make-agent
                           :client (maxwell:make-client :model "parent-model")
                           :model-function (lambda (messages tools)
                                             (declare (ignore messages tools))
                                             (fake-response :content "child result"))))
         (maxwell::*ui-thread* (bt:current-thread)))
    (maxwell::ensure-conversations)
    (let* ((main maxwell::*selected-conversation*)
           (main-chat maxwell:*chat*)
           (fresh (maxwell:create-conversation "fresh")))
      (maxwell::chat-append main-chat :user "parent-only")
      (let ((fork (maxwell:create-conversation "fork" :snapshot t)))
        (check (= 1 (maxwell::chat-message-count (maxwell:conversation-chat fork))))
        (maxwell::chat-append main-chat :user "later-parent-only")
        (check (= 1 (maxwell::chat-message-count (maxwell:conversation-chat fork)))))
      (check (zerop (maxwell::chat-message-count (maxwell:conversation-chat fresh))))
      (check (= (maxwell:conversation-id main) (maxwell::conversation-parent fresh)))
      (setf (maxwell:client-model (maxwell::agent-client (maxwell::conversation-agent fresh))) "child-model")
      (check (equal "parent-model" (maxwell:client-model (maxwell::agent-client maxwell:*agent*))))
      ;; Notes do not wake or enter context early; delivery happens exactly once.
      (maxwell:send-conversation "fresh" "remember this")
      (check (eq :idle (maxwell:conversation-state fresh)))
      (check (zerop (maxwell::chat-message-count (maxwell:conversation-chat fresh))))
      (maxwell::deliver-conversation-notes fresh)
      (maxwell::deliver-conversation-notes fresh)
      (check (= 1 (maxwell::chat-message-count (maxwell:conversation-chat fresh))))
      (check (eql 0 (maxwell::conversation-note-delivered (first (maxwell:conversation-inbox fresh)))))
      ;; UI jobs from an unselected conversation record into its own transcript.
      (maxwell:start-conversation "fresh" "do the task" :report-to (maxwell:conversation-id main))
      (let ((deadline (+ (get-internal-real-time) (* 5 internal-time-units-per-second))))
        (loop while (and (maxwell::conversation-running-p fresh)
                         (< (get-internal-real-time) deadline))
              do (maxwell::drain-ui-queue) (sleep 0.01)))
      (check (not (maxwell::conversation-running-p fresh)))
      (maxwell::service-conversations)
      (check (eq :idle (maxwell:conversation-state fresh)))
      (check (plusp (length (maxwell::conversation-entries fresh))))
      (check (zerop (length (maxwell::conversation-entries main))))
      (check (= 2 (maxwell::chat-message-count main-chat)))
      (check (= 1 (length (maxwell:conversation-inbox main))))
      (maxwell::service-conversations)
      (check (= 1 (length (maxwell:conversation-inbox main))))
      ;; Steering queues are independent, including when both conversations work.
      (maxwell::queue-steering "main steer")
      (maxwell::call-in-conversation fresh (lambda () (maxwell::queue-steering "child steer")))
      (check (equal '("main steer") (maxwell::take-steering)))
      (maxwell::call-in-conversation fresh
        (lambda () (check (equal '("child steer") (maxwell::take-steering)))))
      ;; The versioned resume format retains histories, clients and delivery IDs.
      (let* ((form (maxwell::resume-state-form))
             (count (maxwell::chat-message-count (maxwell:conversation-chat fresh)))
             (path (merge-pathnames (format nil "maxwell-resume-test-~A.sexp" (maxwell::random-value 6))
                                   (uiop:temporary-directory))))
        (unwind-protect
             (progn
               (maxwell::write-resume-state path)
               (check (= #o600 (logand #o777 (sb-posix:stat-mode (sb-posix:stat path)))))
               (maxwell::read-resume-state path)
               (check (= 3 (length maxwell::*conversations*)))
               (check (equal "main" (maxwell:conversation-name maxwell::*selected-conversation*)))
               (let ((restored (maxwell:find-conversation "fresh")))
                 (check (= count (maxwell::chat-message-count (maxwell:conversation-chat restored))))
                 (check (eql 0 (maxwell::conversation-note-delivered
                                 (first (maxwell:conversation-inbox restored))))))
               (check (handler-case
                          (progn (maxwell::restore-resume-state '(:maxwell-state :version 999)) nil)
                        (error () t)))
               (check (= 3 (length maxwell::*conversations*)))
               (check (equal (getf (rest form) :selected)
                             (maxwell:conversation-id maxwell::*selected-conversation*))))
          (when (probe-file path) (delete-file path))))
      ;; Cancellation stops only the named conversation, not the selected one.
      (let ((c (maxwell:find-conversation "fresh")))
        (setf (maxwell::agent-model-function (maxwell::conversation-agent c))
              (lambda (messages tools) (declare (ignore messages tools))
                (sleep 30) (fake-response :content "should not arrive")))
        (maxwell:start-conversation "fresh" "slow task")
        (maxwell:stop-conversation "fresh")
        (check (eq :stopped (maxwell:conversation-state c)))
        (check (equal "main" (maxwell:conversation-name maxwell::*selected-conversation*)))))))
